#include <windows.h>

1 RT_MANIFEST "app.manifest"

// Program icon: OTS in a dash-dot frame with a mouse cursor (drawn by res/make_icon.py).
101 ICON "app.ico"

// Sounds after saving (see res/sounds/CREDITS.md for their authors and licences).
201 RCDATA "sounds/glass.wav"
202 RCDATA "sounds/birds.wav"

// Authorship information.
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Oleksii Tatarinov"
            VALUE "FileDescription", "OscreenSaver - screenshot tool"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "OscreenSaver"
            VALUE "LegalCopyright", "Copyright (C) 2026 Oleksii Tatarinov. MIT License."
            VALUE "OriginalFilename", "OscreenSaver.exe"
            VALUE "ProductName", "OscreenSaver"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
